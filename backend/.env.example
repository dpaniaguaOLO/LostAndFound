# Puerto del servidor HTTP
PORT=4000

# Entorno. En producción: NODE_ENV=production (activa HSTS y exige JWT_SECRET >= 32 caracteres)
NODE_ENV=development

# Orígenes permitidos para CORS, separados por comas.
# Producción: el dominio HTTPS de la web y, si se usa la app Android, https://localhost
CORS_ORIGIN=http://localhost:5173

# Conexión de base de datos (SQLite para desarrollo)
DATABASE_URL="file:./dev.db"

# Secreto para firmar los JWT. CAMBIAR en cada entorno.
# Generar uno seguro, p. ej.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-este-valor-por-uno-aleatorio-largo
JWT_EXPIRES_IN=12h

# Carpeta local donde se guardan las imágenes subidas
UPLOAD_DIR=./uploads

# Tamaño máximo de imagen en bytes (5 MB)
MAX_UPLOAD_BYTES=5242880

# Validez (segundos) de las URLs firmadas de imágenes (/uploads/...?exp=&sig=)
UPLOAD_URL_TTL_SECONDS=3600

# --- Producción: HTTPS y proxy ---------------------------------------------------
# Número de proxies de confianza delante del servidor (p. ej. 1 detrás de un
# balanceador/Nginx). Vacío = no se confía en X-Forwarded-* (valor seguro por defecto).
TRUST_PROXY=
# Redirige HTTP -> HTTPS (activar en producción; requiere TRUST_PROXY si TLS termina en el proxy)
FORCE_HTTPS=false

# --- Registro de cuentas ------------------------------------------------------------
# App interna: en producción se recomienda false y dar de alta a los colaboradores
# de forma controlada (seed, panel o script de administración).
ALLOW_SELF_REGISTRATION=true
