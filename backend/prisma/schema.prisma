// Esquema de datos de Lost and Found.
// Base de datos de desarrollo: SQLite. Para producción se recomienda PostgreSQL
// (cambiar el provider y DATABASE_URL). Documentado en CLAUDE.md -> Decisiones técnicas.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  employeeId   String   @unique // número de colaborador (identificador de acceso)
  email        String?  @unique // opcional; ya no se usa para iniciar sesión
  passwordHash String
  role         String   @default("EMPLOYEE") // EMPLOYEE | ADMIN
  // Se incrementa al restablecer la contraseña: invalida todos los JWT emitidos antes.
  sessionVersion Int    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  foundItems    FoundItem[]
  lostReports   LostReport[]
  claims        Claim[]        @relation("ClaimClaimant")
  reviewedClaims Claim[]       @relation("ClaimReviewer")
  notifications Notification[]
  auditLogs     AuditLog[]
}

model FoundItem {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String   // ver ItemCategory en @laf/shared
  location    String
  foundAt     DateTime
  imageUrl    String?
  imageSignature String? // firma visual (JSON) para búsqueda por imagen
  status      String   @default("PUBLISHED") // PUBLISHED | CLAIMED | RETURNED | ARCHIVED
  returnedAt  DateTime? // cuándo se marcó RETURNED (null si no está devuelto)
  reporterId  String
  reporter    User     @relation(fields: [reporterId], references: [id])
  claims      Claim[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([category])
}

model LostReport {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String
  location    String
  lostAt      DateTime
  imageUrl    String?
  imageSignature String? // firma visual (JSON) para búsqueda por imagen
  status      String   @default("OPEN") // OPEN | MATCHED | RESOLVED | CLOSED
  reporterId  String
  reporter    User     @relation(fields: [reporterId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([category])
}

model Claim {
  id          String   @id @default(cuid())
  foundItemId String
  foundItem   FoundItem @relation(fields: [foundItemId], references: [id])
  claimantId  String
  claimant    User     @relation("ClaimClaimant", fields: [claimantId], references: [id])
  message     String
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  reviewerId  String?
  reviewer    User?    @relation("ClaimReviewer", fields: [reviewerId], references: [id])
  reviewNote  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([foundItemId])
}

model Notification {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  type          String   // ver NotificationType en @laf/shared
  title         String
  body          String
  read          Boolean  @default(false)
  relatedItemId String?
  createdAt     DateTime @default(now())

  @@index([userId, read])
}

// JWT revocados antes de caducar (cierre de sesión). Se guarda solo el `jti`
// (identificador aleatorio del token), nunca el token. Se purgan al expirar.
model RevokedToken {
  jti       String   @id
  expiresAt DateTime

  @@index([expiresAt])
}

// Registro de auditoría: eventos clave para trazabilidad (devoluciones,
// moderación, cambios de rol). Lo consulta el historial del panel admin.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String // usuario que ejecutó la acción
  actor      User     @relation(fields: [actorId], references: [id])
  action     String // p. ej. FOUND_ITEM_RETURNED, CLAIM_REVIEWED, USER_ROLE_CHANGED
  entityType String // FoundItem | LostReport | Claim | User
  entityId   String
  summary    String // texto legible del evento
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}
