# Dependencias
node_modules/
**/node_modules/

# Builds
dist/
build/
**/dist/
**/build/

# Variables de entorno (NUNCA commitear secretos)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Claves, certificados y firmas (Android release, TLS, service accounts)
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
keystore.properties
google-services.json
service-account*.json

# Base de datos local (SQLite dev)
*.db
*.db-journal
*.sqlite
*.sqlite3
backend/prisma/dev.db*

# Archivos subidos por usuarios (fotografías) — se conserva la carpeta vacía
backend/uploads/*
!backend/uploads/.gitkeep

# Logs
*.log
npm-debug.log*
logs/

# Caché de herramientas
.vite/
.cache/
coverage/
.eslintcache

# Entornos de Python (herramientas de presentación/capturas)
.venv/
__pycache__/
*.pyc

# Sistema operativo / editor
.DS_Store
Thumbs.db
.idea/
*.swp
.vscode/*
!.vscode/extensions.json

# Supabase CLI (artefactos locales; no versionar)
supabase/.temp/
supabase/.branches/
