# Configuración del frontend de Lost and Found (Vite).
# Copia este archivo a .env (local) o .env.production y pon valores reales.
# NUNCA incluyas aquí secretos de servidor (service_role, claves privadas).

# --- Backend de datos -------------------------------------------------------
# 'rest'     -> usa el backend Express actual (por defecto).
# 'supabase' -> usa Supabase directamente (requiere las variables de abajo).
VITE_DATA_BACKEND=rest

# Base URL del backend REST.
#  - En web/desarrollo déjalo vacío para usar el proxy de Vite (/api -> :4000).
#  - En Android (Capacitor) DEBE ser la URL real del backend accesible desde el
#    teléfono, p. ej. https://api.lostandfound.olo.com  (no uses localhost).
VITE_API_BASE_URL=

# --- Supabase (clave pública/anon; segura en el cliente con RLS activo) -----
# Las encuentras en el panel de Supabase: Project Settings > API.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica-ficticia
